# Copy to .env and fill in real values. Never commit .env.
# Gmail
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Groq (https://console.groq.com) — key used for AI tailoring
GROQ_API_KEY=gsk_...

# Telegram bot (create via @BotFather, get token) + your numeric chat id
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# Shown in the application email signature
YOUR_NAME=Your Name

# How often to poll Gmail in minutes (runner fallback when not passed as arg)
POLL_INTERVAL_MIN=15

# Optional: explicit path to LibreOffice soffice.exe if not on PATH
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe