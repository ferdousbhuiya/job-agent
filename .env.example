# Copy to .env and fill in real values. Never commit .env.
# Gmail
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Groq (https://console.groq.com) — key used for AI tailoring
GROQ_API_KEY=gsk_...

# Telegram bot (create via @BotFather, get token) + your numeric chat id
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# Shown in the application email signature
YOUR_NAME=Your Name

# How often to poll Gmail in minutes (runner fallback when not passed as arg)
POLL_INTERVAL_MIN=15

# How many days back to scan for job emails (default 3 when unset)
# SCAN_DAYS=3

# Resend (https://resend.com) — used to send application emails over HTTPS.
# Gmail SMTP is blocked/undeliverable on several hosts (Render, Hetzner abuse
# filters), so outbound mail goes through Resend's REST API on port 443.
RESEND_API_KEY=re_...
# From address. Use a Resend **verified** domain, or Resend's default
# onboarding@resend.dev (works for everything except Gmail/Outlook replying).
RESEND_FROM=onboarding@resend.dev

# Optional: explicit path to LibreOffice soffice.exe if not on PATH
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Optional: explicit path to LibreOffice soffice.exe if not on PATH
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe